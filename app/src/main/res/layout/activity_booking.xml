<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8ED">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBookingBar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Your Trip"
                android:textColor="#009772"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tvBookingPackageName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Package Name"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Travel Date"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvTravelDate"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/rounded_top_corners"
                android:backgroundTint="#FFFFFF"
                android:text="Select Date"
                android:textColor="#212121"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                android:elevation="2dp"
                android:layout_marginBottom="25dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Travelers"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Adults\n(Over 12 yrs)"
                    android:textColor="#757575"/>

                <Button
                    android:id="@+id/btnAdultMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:backgroundTint="#D4F1E0"
                    android:textColor="#009772"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAdultCount"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textAlignment="center"
                    android:textColor="#212121"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnAdultPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:backgroundTint="#009772"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Children\n(Under 12 yrs)"
                    android:textColor="#757575"/>

                <Button
                    android:id="@+id/btnChildMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:backgroundTint="#D4F1E0"
                    android:textColor="#009772"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvChildCount"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAlignment="center"
                    android:textColor="#212121"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnChildPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:backgroundTint="#009772"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add-ons"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/cbLocalGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Local Tour Guide (+ Rs. 5,000)"
                android:textColor="#757575"
                android:buttonTint="#009772"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/cbTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Private Transport (+ Rs. 10,000)"
                android:textColor="#757575"
                android:buttonTint="#009772"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBookingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Price"
                android:textColor="#757575"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 0"
                android:textColor="#009772"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:backgroundTint="#009772"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingHorizontal="30dp"/>
    </LinearLayout>

</RelativeLayout>